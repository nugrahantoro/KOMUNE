# ===================================================
# KOMUNE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================
# Copy this file to .env and fill with your actual configuration
# NEVER commit your actual .env file to Git repository!

# Application Environment (development / production)
APP_ENV=production
APP_NAME=Komune
APP_URL=https://demo.sekolah-smartbilling.net/komune

# Primary Database Configuration
DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=komune
DB_CORE_NAME=billing_core

# Payment Gateway / Bank API (BNI)
BNI_CLIENT_ID=your_client_id
BNI_SECRET_KEY=your_secret_key
BNI_URL_TARGET=https://api.bni-ecollection.com/
BNI_DIFF_LIMIT=480
KODE_KOMUNITAS=345

# Default Security
PASS_DEFAULT=komune.
